<div class="view view--half_vertical">
  <div class="layout layout--col gap--medium" style="height: 100%; justify-content: center; align-items: center; text-align: center;">
    {% if status == "in_phase" %}
      <span class="label label--underline">Current Release</span>
      <span class="value value--xlarge">{{ release }}</span>
      <span class="description">Day {{ day }} of {{ total_days }}</span>
      <span class="description">{{ days_remaining }} days left</span>
    {% elsif status == "between_phases" %}
      <span class="label label--underline">Next Release</span>
      <span class="value value--xlarge">{{ release }}</span>
      <span class="description">Starts in {{ days_until_start }} days</span>
    {% else %}
      <span class="label">Release Schedule</span>
      <span class="value">No upcoming release found</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Takt Release</span>
  <span class="instance">{{ today }}</span>
</div>
